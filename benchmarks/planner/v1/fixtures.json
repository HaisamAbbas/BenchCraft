{
  "schema": "aibench.planner-fixtures/1",
  "version": "planner-fixtures-v1",
  "reviewers": [],
  "notes": "Annotations were written by the implementing AI agent for Prompt 12, not by people. No fixture has been reviewed. \u00a723 asks for at least two human reviewers on a subset, with disagreements adjudicated; that has not happened. Held-out families were written after the template planner and were not used to change it.",
  "catalog": [
    {
      "evaluator_id": "catalog.grounded",
      "version": "1.0.0",
      "plugin_id": "catalog",
      "plugin_version": "1",
      "description": "Catalog entry: answer supported by the retrieved passages (model judge).",
      "value_kind": "scalar",
      "direction": "higher",
      "aggregation": "mean",
      "requires": [
        {
          "path": "case.input"
        },
        {
          "path": "execution.output",
          "non_empty": false
        },
        {
          "path": "execution.retrieved_context"
        }
      ],
      "default_rule": {
        "comparator": ">=",
        "threshold": 0.5
      },
      "uses_models": true
    },
    {
      "evaluator_id": "catalog.tool_names",
      "version": "1.0.0",
      "plugin_id": "catalog",
      "plugin_version": "1",
      "description": "Catalog entry: the expected tools were called.",
      "value_kind": "boolean",
      "direction": "higher",
      "aggregation": "rate",
      "requires": [
        {
          "path": "execution.tool_events"
        },
        {
          "path": "case.reference.tools"
        }
      ],
      "default_rule": {
        "comparator": "is_true"
      }
    },
    {
      "evaluator_id": "catalog.refund_rule",
      "version": "1.0.0",
      "plugin_id": "catalog",
      "plugin_version": "1",
      "description": "Catalog entry: the answer states the case's refund window.",
      "value_kind": "boolean",
      "direction": "higher",
      "aggregation": "rate",
      "requires": [
        {
          "path": "execution.output",
          "non_empty": false
        },
        {
          "path": "case.expectations.refund_days"
        }
      ],
      "default_rule": {
        "comparator": "is_true"
      }
    }
  ],
  "policies": {
    "judges": {
      "allow_trusted_local": true,
      "allowed_evaluators": [
        "native.*",
        "catalog.*"
      ],
      "allow_model_evaluators": true
    },
    "no_judges": {
      "allow_trusted_local": true,
      "allowed_evaluators": [
        "native.*",
        "catalog.*"
      ],
      "allow_model_evaluators": false
    },
    "native_only": {
      "allow_trusted_local": true,
      "allowed_evaluators": [
        "native.*"
      ]
    },
    "strict": {
      "allowed_evaluators": [
        "native.*",
        "catalog.*"
      ]
    }
  },
