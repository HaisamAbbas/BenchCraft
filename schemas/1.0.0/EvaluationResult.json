{
  "$defs": {
    "Decision": {
      "enum": [
        "pass",
        "fail",
        "indeterminate",
        "not_evaluated"
      ],
      "title": "Decision",
      "type": "string"
    },
    "DecisionRule": {
      "additionalProperties": false,
      "description": "Harness-owned pass/fail rule using frozen thresholds.",
      "properties": {
        "categories": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Categories",
          "type": "array"
        },
        "comparator": {
          "enum": [
            "is_true",
            ">=",
            ">",
            "<=",
            "<",
            "==",
            "in"
          ],
          "title": "Comparator",
          "type": "string"
        },
        "rule_id": {
          "default": "threshold",
          "title": "Rule Id",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "version": {
          "default": "1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "comparator"
      ],
      "title": "DecisionRule",
      "type": "object"
    },
    "ExecutionStatus": {
      "enum": [
        "ok",
        "error",
        "not_applicable",
        "skipped",
        "cancelled"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "MetricDirection": {
      "enum": [
        "higher",
        "lower",
        "target",
        "none"
      ],
      "title": "MetricDirection",
      "type": "string"
    },
    "MetricScope": {
      "enum": [
        "case",
        "episode",
        "component",
        "slice",
        "run"
      ],
      "title": "MetricScope",
      "type": "string"
    },
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "scalar",
            "boolean",
            "category",
            "vector",
            "distribution",
            "structured"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "MetricValue",
      "type": "object"
    }
  },
  "$id": "aibench/1.0.0/EvaluationResult.json",
  "$schemaVersion": "1.0.0",
  "additionalProperties": false,
  "properties": {
    "attempt_number": {
      "default": 0,
      "title": "Attempt Number",
      "type": "integer"
    },
    "binding_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Binding Hash"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/Decision"
    },
    "direction": {
      "anyOf": [
        {
          "$ref": "#/$defs/MetricDirection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "execution_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execution Id"
    },
    "metric_id": {
      "title": "Metric Id",
      "type": "string"
    },
    "metric_version": {
      "title": "Metric Version",
      "type": "string"
    },
    "provenance": {
      "title": "Provenance"
    },
    "raw_artifact_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Artifact Ref"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "repetition_id": {
      "default": 0,
      "title": "Repetition Id",
      "type": "integer"
    },
    "resources": {
      "title": "Resources"
    },
    "result_id": {
      "title": "Result Id",
      "type": "string"
    },
    "rule": {
      "anyOf": [
        {
          "$ref": "#/$defs/DecisionRule"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/MetricScope",
      "default": "case"
    },
    "scoring_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scoring Id"
    },
    "status": {
      "$ref": "#/$defs/ExecutionStatus"
    },
    "uncertainty": {
      "default": null,
      "title": "Uncertainty"
    },
    "value": {
      "anyOf": [
        {
          "$ref": "#/$defs/MetricValue"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "result_id",
    "run_id",
    "case_id",
    "metric_id",
    "metric_version",
    "status",
    "decision"
  ],
  "title": "EvaluationResult",
  "type": "object"
}
