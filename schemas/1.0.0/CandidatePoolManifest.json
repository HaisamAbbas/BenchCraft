{
  "$defs": {
    "CandidateSourceDocument": {
      "additionalProperties": false,
      "description": "One bounded, user-selected development source and any exact-content aliases.",
      "properties": {
        "character_count": {
          "minimum": 1,
          "title": "Character Count",
          "type": "integer"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "duplicate_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Of"
        },
        "line_count": {
          "minimum": 1,
          "title": "Line Count",
          "type": "integer"
        },
        "source_ref": {
          "title": "Source Ref",
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "digest",
        "character_count",
        "line_count"
      ],
      "title": "CandidateSourceDocument",
      "type": "object"
    }
  },
  "$id": "aibench/1.0.0/CandidatePoolManifest.json",
  "$schemaVersion": "1.0.0",
  "additionalProperties": false,
  "description": "Metadata for a development-only generation job.\n\nHoldout cases do not have a representable pool type, so a generation service cannot\naccidentally accept them as prompt context.",
  "properties": {
    "candidate_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Candidate Ids",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "generator_identity": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Generator Identity",
      "type": "string"
    },
    "pool_id": {
      "title": "Pool Id",
      "type": "string"
    },
    "prompt_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Prompt Hash",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/CandidateSourceDocument"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "split_id": {
      "const": "development",
      "default": "development",
      "title": "Split Id",
      "type": "string"
    }
  },
  "required": [
    "pool_id",
    "generator_identity",
    "prompt_hash",
    "sources"
  ],
  "title": "CandidatePoolManifest",
  "type": "object"
}
