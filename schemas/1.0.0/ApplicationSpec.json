{
  "$defs": {
    "CliTransport": {
      "additionalProperties": false,
      "description": "One-shot CLI protocol (\u00a77): a static argv array (never a shell string, never\ninterpolated with case text), JSON on stdin, JSON (or explicit legacy text) on stdout,\ndiagnostics on stderr.",
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Argv",
          "type": "array"
        },
        "cwd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cwd"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Env",
          "type": "object"
        },
        "healthcheck_argv": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Healthcheck Argv"
        },
        "inherit_env": {
          "default": [
            "PATH",
            "PATHEXT",
            "SYSTEMROOT",
            "SYSTEMDRIVE",
            "WINDIR",
            "COMSPEC",
            "TEMP",
            "TMP",
            "TMPDIR",
            "HOME",
            "USERPROFILE",
            "LANG",
            "LC_ALL",
            "LC_CTYPE"
          ],
          "items": {
            "type": "string"
          },
          "title": "Inherit Env",
          "type": "array"
        },
        "kind": {
          "const": "cli",
          "default": "cli",
          "title": "Kind",
          "type": "string"
        },
        "max_stderr_bytes": {
          "default": 65536,
          "minimum": 0,
          "title": "Max Stderr Bytes",
          "type": "integer"
        },
        "max_stdout_bytes": {
          "default": 1048576,
          "exclusiveMinimum": 0,
          "title": "Max Stdout Bytes",
          "type": "integer"
        },
        "output_mode": {
          "default": "json",
          "enum": [
            "json",
            "text"
          ],
          "title": "Output Mode",
          "type": "string"
        },
        "secret_env": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Secret Env",
          "type": "object"
        },
        "timeout_seconds": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "argv"
      ],
      "title": "CliTransport",
      "type": "object"
    },
    "EffectLevel": {
      "enum": [
        "none",
        "reversible",
        "irreversible"
      ],
      "title": "EffectLevel",
      "type": "string"
    },
    "HttpSecretHeader": {
      "additionalProperties": false,
      "properties": {
        "prefix": {
          "default": "",
          "title": "Prefix",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "title": "HttpSecretHeader",
      "type": "object"
    },
    "HttpTransport": {
      "additionalProperties": false,
      "description": "JSON request/response protocol (\u00a77). Redirects are refused by default; when enabled,\nonly method-preserving redirects (307/308) to URLs that pass the endpoint policy are\nfollowed.",
      "properties": {
        "allow_plaintext_http": {
          "default": false,
          "title": "Allow Plaintext Http",
          "type": "boolean"
        },
        "allowed_endpoints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Endpoints",
          "type": "array"
        },
        "ca_bundle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ca Bundle"
        },
        "connect_timeout_seconds": {
          "default": 10.0,
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Connect Timeout Seconds",
          "type": "number"
        },
        "correlation_header": {
          "default": "X-Request-ID",
          "title": "Correlation Header",
          "type": "string"
        },
        "follow_redirects": {
          "default": false,
          "title": "Follow Redirects",
          "type": "boolean"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Headers",
          "type": "object"
        },
        "healthcheck_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Healthcheck Url"
        },
        "kind": {
          "const": "http",
          "default": "http",
          "title": "Kind",
          "type": "string"
        },
        "max_redirects": {
          "default": 3,
          "maximum": 10,
          "minimum": 0,
          "title": "Max Redirects",
          "type": "integer"
        },
        "max_request_bytes": {
          "default": 1048576,
          "exclusiveMinimum": 0,
          "title": "Max Request Bytes",
          "type": "integer"
        },
        "max_response_bytes": {
          "default": 1048576,
          "exclusiveMinimum": 0,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "method": {
          "default": "POST",
          "enum": [
            "POST",
            "PUT"
          ],
          "title": "Method",
          "type": "string"
        },
        "reset_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reset Url"
        },
        "secret_headers": {
          "additionalProperties": {
            "$ref": "#/$defs/HttpSecretHeader"
          },
          "title": "Secret Headers",
          "type": "object"
        },
        "timeout_seconds": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "verify_tls": {
          "default": true,
          "title": "Verify Tls",
          "type": "boolean"
        }
      },
      "required": [
        "url"
      ],
      "title": "HttpTransport",
      "type": "object"
    },
    "ResetPolicy": {
      "enum": [
        "per_case",
        "per_episode",
        "shared"
      ],
      "title": "ResetPolicy",
      "type": "string"
    },
    "RunnerKind": {
      "enum": [
        "cli",
        "http"
      ],
      "title": "RunnerKind",
      "type": "string"
    }
  },
  "$id": "aibench/1.0.0/ApplicationSpec.json",
  "$schemaVersion": "1.0.0",
  "additionalProperties": false,
  "properties": {
    "application_id": {
      "title": "Application Id",
      "type": "string"
    },
    "effects": {
      "$ref": "#/$defs/EffectLevel",
      "default": "none"
    },
    "environment_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Environment Digest"
    },
    "input_binding": {
      "title": "Input Binding"
    },
    "output_binding": {
      "title": "Output Binding"
    },
    "reset_policy": {
      "$ref": "#/$defs/ResetPolicy",
      "default": "per_case"
    },
    "revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision"
    },
    "runner": {
      "$ref": "#/$defs/RunnerKind"
    },
    "target": {
      "title": "Target",
      "type": "string"
    },
    "transport": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "cli": "#/$defs/CliTransport",
              "http": "#/$defs/HttpTransport"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CliTransport"
            },
            {
              "$ref": "#/$defs/HttpTransport"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transport"
    }
  },
  "required": [
    "application_id",
    "runner",
    "target"
  ],
  "title": "ApplicationSpec",
  "type": "object"
}
