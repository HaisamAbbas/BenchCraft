      "type": "integer"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "cost": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "execution_id": {
      "title": "Execution Id",
      "type": "string"
    },
    "observation_completeness": {
      "title": "Observation Completeness"
    },
    "output": {
      "default": null,
      "title": "Output"
