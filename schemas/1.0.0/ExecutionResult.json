{
  "$defs": {
    "EffectState": {
      "description": "What is known about external effects of one invocation (\u00a715: \"A timeout does not\nprove a server-side operation did not occur\"). Runners never retry; the engine uses this\nto decide whether a retry is safe or intervention is required.",
      "enum": [
        "none_declared",
        "not_dispatched",
        "completed",
        "unknown"
      ],
      "title": "EffectState",
      "type": "string"
    },
    "ErrorKind": {
      "description": "Why an application invocation did not produce a usable output (\u00a77, \u00a715). Separates\napplication/transport failures from evaluator failures and from policy denials.",
      "enum": [
        "binding",
        "request_limit",
        "policy_denied",
        "spawn_failed",
        "timeout",
        "cancelled",
        "output_limit",
        "nonzero_exit",
        "http_status",
        "redirect_rejected",
        "transport",
        "invalid_output"
      ],
      "title": "ErrorKind",
      "type": "string"
    },
    "ExecutionStatus": {
      "enum": [
        "ok",
        "error",
        "not_applicable",
        "skipped",
        "cancelled"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    }
  },
  "$id": "aibench/1.0.0/ExecutionResult.json",
  "$schemaVersion": "1.0.0",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "default": 0,
      "title": "Attempt Id",
      "type": "integer"
    },
    "cache": {
      "default": null,
      "title": "Cache"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "correlation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "cost": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost"
    },
    "effect_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/EffectState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "error_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorKind"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "execution_id": {
      "title": "Execution Id",
      "type": "string"
    },
    "observation_completeness": {
      "title": "Observation Completeness"
    },
    "output": {
      "default": null,
      "title": "Output"
    },
    "repetition_id": {
      "default": 0,
      "title": "Repetition Id",
      "type": "integer"
    },
    "retrieved_context": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retrieved Context"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ExecutionStatus"
    },
    "timing": {
      "title": "Timing"
    },
    "tool_events": {
      "items": {},
      "title": "Tool Events",
      "type": "array"
    },
    "trace_refs": {
      "items": {
        "type": "string"
      },
      "title": "Trace Refs",
      "type": "array"
    },
    "usage": {
      "default": null,
      "title": "Usage"
    },
    "world_state": {
      "default": null,
      "title": "World State"
    }
  },
  "required": [
    "execution_id",
    "run_id",
    "case_id",
    "status"
  ],
  "title": "ExecutionResult",
  "type": "object"
}
