{
  "application_id": "example-container-app",
  "runner": "container",
  "target": "python@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9",
  "effects": "none",
  "transport": {
    "kind": "container",
    "image": "python@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9",
    "argv": ["python", "/app/app.py"],
    "mounts": [{"source": "container_app", "target": "/app"}],
